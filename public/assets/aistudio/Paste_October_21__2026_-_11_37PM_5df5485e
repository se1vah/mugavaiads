const money = n => new Intl.NumberFormat("en-IN",{style:"currency",currency:"INR",minimumFractionDigits:2,maximumFractionDigits:2}).format(n);
const dateToday = () => {const d=new Date();return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,"0")}-${String(d.getDate()).padStart(2,"0")}`};
const fmtDate = v => {if(!v)return "—";const [y,m,d]=v.split("-");return `${d}/${m}/${y}`};
$("businessLogo").src = LOGO_URL;
$("billDate").value = dateToday();

function addRow(data={}) {
 const tr=document.createElement("tr");
 tr.innerHTML=`<td class="sno"></td><td><input class="desc" aria-label="Description" placeholder="Service description" value=""></td><td><div class="platform-options" role="group" aria-label="Ad Platform"><label><input class="platform-choice" type="checkbox" value="Instagram" checked> Instagram</label><label><input class="platform-choice" type="checkbox" value="Facebook"> Facebook</label><label><input class="platform-choice" type="checkbox" value="YouTube"> YouTube</label></div></td><td><input class="from" type="date" aria-label="From Date"></td><td><input class="to" type="date" aria-label="To Date"></td><td><input class="amt" type="number" min="0" step="0.01" inputmode="decimal" placeholder="0.00" aria-label="Amount"></td><td><button type="button" class="remove" aria-label="Remove row">×</button></td>`;
 $("itemsBody").appendChild(tr);
 tr.querySelector(".desc").value=data.description||"";
 const initialPlatforms = Array.isArray(data.platforms) ? data.platforms : (data.platform ? [data.platform] : ["Instagram"]);
 tr.querySelectorAll(".platform-choice").forEach(cb=>cb.checked=initialPlatforms.includes(cb.value));
 tr.querySelector(".from").value=data.from||"";
 tr.querySelector(".to").value=data.to||"";
 tr.querySelector(".amt").value=data.amount??"";
 tr.querySelector(".remove").addEventListener("click",()=>{tr.remove();renumber();updateInvoice();});
 tr.addEventListener("input",()=>{const from=tr.querySelector(".from").value;tr.querySelector(".to").min=from||"";updateInvoice();});
 tr.querySelector(".from").addEventListener("change",()=>{const from=tr.querySelector(".from").value,to=tr.querySelector(".to");to.min=from||"";if(from&&to.value&&to.value<from){to.setCustomValidity(translations[language].dateInvalid)}else to.setCustomValidity("");updateInvoice();});
 tr.querySelector(".to").addEventListener("change",()=>{const from=tr.querySelector(".from").value,to=tr.querySelector(".to");to.setCustomValidity(from&&to.value&&to.value<from?translations[language].dateInvalid:"");updateInvoice();});
 renumber();updateInvoice();
}
function renumber(){[...$("itemsBody").rows].forEach((r,i)=>r.querySelector(".sno").textContent=i+1)}
function getRows(){return [...$("itemsBody").rows].map(r=>({description:r.querySelector(".desc").value.trim(),platforms:[...r.querySelectorAll(".platform-choice:checked")].map(cb=>cb.value),from:r.querySelector(".from").value,to:r.querySelector(".to").value,amount:r.querySelector(".amt").value}))}
function getTotal(){return getRows().reduce((s,r)=>s+(r.amount!==""&&Number.isFinite(Number(r.amount))&&Number(r.amount)>=0?Number(r.amount):0),0)}
function customerData(){return {name:$("clientName").value.trim(),street:$("street").value.trim(),place:$("place").value.trim(),district:$("district").value.trim(),state:$("state").value.trim(),pincode:$("pincode").value.trim(),contact:$("contact").value.trim(),email:$("email").value.trim()}}
function validate(){
 const t=translations[language], c=customerData(), errors=[];
 if(!$("billNumber").value.trim())errors.push(t.enterBill);
 if(!c.name||!c.street||!c.place||!c.district||!c.state||!c.pincode||!c.contact)errors.push(t.required);
 if(c.email&&!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(c.email))errors.push(t.emailInvalid);
 if(!/^\d{6}$/.test(c.pincode))errors.push(t.pinInvalid);
 if(!/^[6-9]\d{9}$/.test(c.contact))errors.push(t.contactInvalid);
 const rows=getRows();if(!rows.length)errors.push(t.itemRequired);
 rows.forEach(r=>{if(!r.description)errors.push(t.descriptionRequired);if(!r.platforms.length)errors.push(t.platformRequired);if(r.amount===""||!Number.isFinite(Number(r.amount))||Number(r.amount)<0)errors.push(t.amountInvalid);if(r.from&&r.to&&r.to<r.from)errors.push(t.dateInvalid)});
 $("errorBox").textContent=[...new Set(errors)].join(" ");
 return errors.length===0;
}
function updateInvoice(){
 const t=translations[language],c=customerData(),rows=getRows();
 $("formTotal").textContent=money(getTotal());$("outTotal").textContent=money(getTotal());
 $("outBillNumber").textContent=$("billNumber").value.trim()||"—";
 $("outBillDate").textContent=fmtDate($("billDate").value);
 $("customerOutput").innerHTML="";
 const pairs=[[t.name,c.name],[t.streetLabel,c.street],[t.placeLabel,c.place],[t.districtLabel,c.district],[t.stateLabel,c.state],[t.pinLabel,c.pincode],[t.contactLabel,c.contact]];
 if(c.email)pairs.push([t.emailLabel,c.email]);
 pairs.forEach(([label,value])=>{const div=document.createElement("div");const strong=document.createElement("strong");strong.textContent=label+": ";div.append(strong,document.createTextNode(value||"—"));$("customerOutput").appendChild(div)});
 $("invoiceItems").innerHTML="";
 rows.forEach((r,i)=>{const tr=document.createElement("tr");[String(i+1),r.description||"—",r.platforms.join(", ")||"—",fmtDate(r.from),fmtDate(r.to),r.amount!==""&&Number(r.amount)>=0?money(Number(r.amount)):money(0)].forEach(v=>{const td=document.createElement("td");td.textContent=v;tr.appendChild(td)});$("invoiceItems").appendChild(tr)});
 if(!rows.length){const tr=document.createElement("tr");const td=document.createElement("td");td.colSpan=6;td.textContent="—";td.style.textAlign="center";tr.appendChild(td);$("invoiceItems").appendChild(tr)}
 $("businessName").textContent=t.businessName;$("businessStreet").textContent=t.businessStreet;$("businessPlace").textContent=t.businessPlace;$("businessState").textContent=t.businessState;$("businessContact").textContent=t.businessContact;$("businessEmail").textContent=t.businessEmail;$("businessInstagram").textContent=t.businessInstagram;
 $("invoiceTitle").textContent=t.invoice;$("billNumberLabel").textContent=t.billNumberLabel;$("billDateLabel").textContent=t.billDateLabel;$("customerTitle").textContent=t.customerTitle;$("thSno").textContent=t.sno;$("thDescription").textContent=t.description;$("thPlatform").textContent=t.platform;$("thFrom").textContent=t.fromDate;$("thTo").textContent=t.toDate;$("thAmount").textContent=t.amount;$("totalLabel").textContent=t.totalLabel;$("signatureLabel").textContent=t.signature;$("footerText").textContent=t.footer;
 $("invoice").classList.toggle("tamil",language==="ta");
}
function setLanguage(lang){
 language=lang;document.documentElement.lang=lang==="ta"?"ta":"en";
 $("enBtn").classList.toggle("active",lang==="en");$("taBtn").classList.toggle("active",lang==="ta");
 document.querySelectorAll("[data-i18n]").forEach(el=>{const key=el.dataset.i18n;if(translations[lang][key]){if(el.tagName==="BUTTON"||el.tagName==="H2"||el.tagName==="P"||el.classList.contains("preview-heading"))el.textContent=translations[lang][key];else if(el.tagName==="LABEL"){const star=el.querySelector(".required");el.textContent=translations[lang][key]+" ";if(star)el.appendChild(star)}}});
 document.querySelectorAll("#itemsBody .remove").forEach(b=>b.title=translations[lang].remove);
 $("siteBusinessName").textContent=lang==="ta"?"முகவை விளம்பரம்":"Mugavai Ads";
 $("tagline").textContent=lang==="ta"?"விளம்பர விலைப்பட்டியல் உருவாக்கி":"Advertising invoice generator";
 updateInvoice();
}
$("addItem").addEventListener("click",()=>addRow());
$("generate").addEventListener("click",()=>{if(validate()){generated=true;$("previewPlaceholder").classList.add("hidden");updateInvoice();$("errorBox").textContent="";if(window.innerWidth<900)$("invoice").scrollIntoView({behavior:"smooth",block:"start"})}});
$("print").addEventListener("click",()=>{if(!validate())return;$("previewPlaceholder").classList.add("hidden");updateInvoice();window.print()});
$("download").addEventListener("click",async()=>{
 if(!validate())return;
 $("previewPlaceholder").classList.add("hidden");updateInvoice();
 const invoice=$("invoice"), originalStyle=invoice.getAttribute("style");
 const filename=`Mugavai-Ads-${$("billNumber").value.trim().replace(/[^a-zA-Z0-9_-]/g,"_")||"invoice"}.pdf`;
 try{
   await document.fonts.ready;
   const logo=$("businessLogo");
   if(logo && !logo.complete) await new Promise(resolve=>{logo.onload=resolve;logo.onerror=resolve});
   // Temporarily size the capture to A4's printable content width at 96dpi.
   invoice.style.width="718px";invoice.style.maxWidth="718px";invoice.style.boxSizing="border-box";invoice.style.padding="24px";
   const opts={margin:[10,10,10,10],filename,image:{type:"jpeg",quality:0.98},html2canvas:{scale:2,useCORS:true,allowTaint:false,backgroundColor:"#ffffff",letterRendering:true,windowWidth:794,scrollX:0,scrollY:0},jsPDF:{unit:"mm",format:"a4",orientation:"portrait",compress:true},pagebreak:{mode:["css","legacy"],avoid:["tr"," .customer-block",".invoice-header",".total-row",".signature"]}};
   await html2pdf().set(opts).from(invoice).save();
 }catch(e){alert(language==="ta"?"PDF உருவாக்க முடியவில்லை. Print என்பதைத் தேர்ந்தெடுத்து Save as PDF பயன்படுத்தவும்.":"PDF could not be generated. Choose Print and select Save as PDF.");}
 finally{if(originalStyle===null)invoice.removeAttribute("style");else invoice.setAttribute("style",originalStyle);updateInvoice()}
});
$("clear").addEventListener("click",()=>{if(!confirm(translations[language].clearConfirm))return;["billNumber","clientName","street","contact","email"].forEach(id=>$(id).value="");$("place").value="Rameswaram";$("district").value="Ramanathapuram";$("state").value="Tamil Nadu";$("pincode").value="623526";$("billDate").value=dateToday();$("itemsBody").innerHTML="";$("errorBox").textContent="";addRow();$("previewPlaceholder").classList.remove("hidden");updateInvoice()});
$("enBtn").addEventListener("click",()=>setLanguage("en"));$("taBtn").addEventListener("click",()=>setLanguage("ta"));
["billNumber","billDate","clientName","street","place","district","state","pincode","contact","email"].forEach(id=>$(id).addEventListener("input",updateInvoice));
addRow();
</script>
