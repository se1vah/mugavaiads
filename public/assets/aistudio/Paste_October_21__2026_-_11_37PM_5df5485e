<body>
<header class="no-print">
  <div><h1 id="siteBusinessName">Mugavai Ads</h1><p id="tagline">Bilingual advertising invoice generator</p></div>
  <div class="lang" aria-label="Language"><button id="enBtn" class="active" type="button">English</button><button id="taBtn" type="button" class="tamil">தமிழ்</button></div>
</header>
<main>
<section class="panel no-print">
  <h2 data-i18n="billDetails">Bill Details</h2>
  <div class="fields">
    <div class="field"><label for="billNumber" data-i18n="billNumber">Bill Number <span class="required">*</span></label><input id="billNumber" autocomplete="off" placeholder="Enter bill number" required></div>
    <div class="field"><label for="billDate" data-i18n="billDate">Bill Date <span class="required">*</span></label><input id="billDate" type="date" required></div>
  </div>
  <div class="section">
    <h2 data-i18n="customerDetails">Customer Details</h2>
    <div class="fields">
      <div class="field full"><label for="clientName" data-i18n="clientName">Client Name <span class="required">*</span></label><input id="clientName" required></div>
      <div class="field full"><label for="street" data-i18n="street">Street Name <span class="required">*</span></label><input id="street" required></div>
      <div class="field"><label for="place" data-i18n="place">Place <span class="required">*</span></label><input id="place" value="Rameswaram" required></div>
      <div class="field"><label for="district" data-i18n="district">District <span class="required">*</span></label><input id="district" value="Ramanathapuram" required></div>
      <div class="field"><label for="state" data-i18n="state">State <span class="required">*</span></label><input id="state" value="Tamil Nadu" required></div>
      <div class="field"><label for="pincode" data-i18n="pincode">Pincode <span class="required">*</span></label><input id="pincode" inputmode="numeric" maxlength="6" pattern="[0-9]{6}" value="623526" required></div>
      <div class="field"><label for="contact" data-i18n="contact">Contact <span class="required">*</span></label><input id="contact" type="tel" inputmode="numeric" maxlength="10" pattern="[6-9][0-9]{9}" required></div>
      <div class="field"><label for="email" data-i18n="email">Email</label><input id="email" type="email"></div>
    </div>
  </div>
  <div class="section">
    <h2 data-i18n="services">Advertising Services</h2>
    <div class="items-wrap">
      <table class="edit-table"><thead><tr>
        <th data-i18n="sno">S.No</th><th data-i18n="description">Description</th><th data-i18n="platform">Ad Platform</th><th data-i18n="fromDate">From Date</th><th data-i18n="toDate">To Date</th><th data-i18n="amount">Amount (₹)</th><th></th>
      </tr></thead><tbody id="itemsBody"></tbody></table>
    </div>
    <div class="btn-row"><button class="btn secondary" id="addItem" type="button" data-i18n="addItem">＋ Add Item</button></div>
    <div id="errorBox" class="error" role="alert"></div>
  </div>
  <div class="section">
    <div style="display:flex;justify-content:space-between;align-items:center;gap:10px"><strong data-i18n="totalAmount">Total Amount</strong><strong id="formTotal" style="font-size:20px;color:var(--accent)">₹0.00</strong></div>
    <div class="btn-row">
      <button class="btn primary" id="generate" type="button" data-i18n="generate">Generate Bill</button>
      <button class="btn secondary" id="print" type="button" data-i18n="print">Print Bill</button>
      <button class="btn secondary" id="download" type="button" data-i18n="download">Download PDF</button>
      <button class="btn outline" id="clear" type="button" data-i18n="clear">Clear Form</button>
    </div>
    <p class="hint" data-i18n="note">Required fields are marked *. No GST is included in this invoice.</p>
  </div>
</section>
<section class="panel preview-panel">
  <div class="preview-heading no-print" data-i18n="preview">INVOICE PREVIEW · A4 PORTRAIT</div>
  <p id="previewPlaceholder" class="preview-placeholder no-print" data-i18n="previewHint">Fill in the form and select Generate Bill to validate and refresh the invoice. The preview updates as you type.</p>
  <article id="invoice" class="invoice" aria-label="Invoice preview">
    <div class="invoice-header">
      <div class="business">
        <h2 id="businessName">Mugavai Ads</h2>
        <p id="businessStreet">Sallaimalai Street</p>
        <p id="businessPlace">Rameswaram, Ramanathapuram (Dt)</p>
        <p id="businessState">Tamil Nadu – 623526</p>
        <p id="businessContact">Contact: 8300023925</p>
        <p id="businessEmail">Email: murugeswin@gmail.com</p>
        <p id="businessInstagram">Instagram: instagram.com/mugavaiseithigal</p>
      </div>
      <img id="businessLogo" class="logo" alt="Mugavai Ads logo" crossorigin="anonymous">
    </div>
    <div class="invoice-title"><h3 id="invoiceTitle">INVOICE</h3><div class="bill-meta"><div><strong id="billNumberLabel">Bill Number:</strong> <span id="outBillNumber">—</span></div><div><strong id="billDateLabel">Bill Date:</strong> <span id="outBillDate">—</span></div></div></div>
    <div class="customer-block"><h4 id="customerTitle">Customer Details</h4><div class="customer-grid" id="customerOutput"></div></div>
    <table class="invoice-table"><thead><tr><th id="thSno">S.No</th><th id="thDescription">Description</th><th id="thPlatform">Ad Platform</th><th id="thFrom">From Date</th><th id="thTo">To Date</th><th id="thAmount">Amount (₹)</th></tr></thead><tbody id="invoiceItems"></tbody></table>
    <div class="total-row"><div class="total-box"><div class="total-label" id="totalLabel">TOTAL AMOUNT</div><div class="total-value" id="outTotal">₹0.00</div></div></div>
    <div class="signature"><div id="signatureLabel">Authorized Signature</div></div>
    <div class="invoice-footer" id="footerText">Thank you for choosing Mugavai Ads – முகவை விளம்பரம்</div>
  </article>
</section>
